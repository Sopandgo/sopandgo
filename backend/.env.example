# Copy to `backend/.env` for local `air` runs (never commit `.env`).
# `backend/.air.toml` loads this file into the backend process; `go run` does not.
# Keep it to what a local backend needs: the root `.env` is for Docker and points
# at container hosts such as gotenberg:3000.

# Must decode to exactly 32 bytes (base64 or hex). Generate: openssl rand -base64 32
# Encrypts SMTP and integration secrets stored in SQLite.
SECRET_ENCRYPTION_KEY=

# Air runs `go run ./cmd/seed-demo-data` before each build. Seeding only happens
# when `./data/app.db` does not exist yet. Set false to skip even on a fresh data dir.
# SEED_DEMO_DATA=true

PDF_EXPORT_ENABLED=false