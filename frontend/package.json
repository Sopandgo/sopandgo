{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --output-structure message-modules",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run i18n:compile && vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.26.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/turndown": "^5.0.6",
		"daisyui": "^5.7.47",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.1.17",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"isomorphic-dompurify": "^3.8.0",
		"lucide-svelte": "^0.562.0",
		"mammoth": "^1.13.0",
		"marked": "^18.1.0",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	}
}
