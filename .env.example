# Copy to `.env` for local `docker compose` (never commit `.env`).
# On Coolify, set the same names in the service Environment Variables UI.

# Public URL you open in the browser (must match login/cookies). No trailing slash.
# (A trailing slash causes broken URLs like //login after deploy.) Local example:
ORIGIN=http://localhost:8087
# Optional: host port for the app (maps to container :80; see docker-compose.yml)
HOST_WEB_PORT=8087

BACKEND_URL=http://127.0.0.1:8080
HOST_HEADER=x-forwarded-host
PROTOCOL_HEADER=x-forwarded-proto
BODY_SIZE_LIMIT=52428800

# Must decode to exactly 32 bytes (base64 or hex). Generate: openssl rand -base64 32
# Encrypts secrets stored in SQLite: SMTP password, Resend API key, Slack webhook URL,
# Gotify token, optional webhook bearer. Not used for JWT/PASETO signing.
SMTP_SECRET_ENCRYPTION_KEY=

# Insert demo users and sample SOPs on first start, when app.db does not exist yet.
# IMPORTANT: leave true only for local evaluation. Set false before first boot for a real lab.
# Has no effect after the database exists.
SEED_DEMO_DATA=true

# Optional: reject unknown audit event_type / entity_type values at write time.
# AUDIT_STRICT_TYPES=false
# Maximum SQLite lock wait for standalone audit writes (Go duration, minimum 1ms).
# AUDIT_BUSY_TIMEOUT=5s

# PDF export
PDF_EXPORT_ENABLED=true
PDF_RENDERER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
PDF_GENERATOR_VERSION=1

# Optional: automatic full-data backups to S3 (same .zip as Admin → Export).
# Uses the same archive as /api/admin/backups/export. See docs/ops/backup-and-restore.md.
# When ACCESS_KEY_ID and SECRET are both empty, the AWS SDK uses the default chain (e.g. IAM role).
BACKUP_S3_ENABLED=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=myorg/prod
# BACKUP_S3_INTERVAL=24h
# BACKUP_S3_RETENTION_MAX=14
# BACKUP_S3_RETENTION_DAYS=30
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_USE_PATH_STYLE=false
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=